<?xml version="1.0" encoding="UTF-8" ?>
<Module>
  <ModulePrefs title="Custom Outlook Calendar" description="Custom calendar gadget supporting weekly and daily views.">
    <Require feature="dynamic-height"/>
  </ModulePrefs>
  
  <UserPref name="icsUrl" display_name="Outlook ICS Webcal URL" type="string" default_value="" />
  <UserPref name="mode" display_name="View Mode (weekly or daily)" type="enum" default_value="weekly">
    <EnumValue value="weekly" display_value="Weekly View" />
    <EnumValue value="daily" display_value="Daily View" />
  </UserPref>
  <UserPref name="maxDays" display_name="Days to Show (Weekly)" type="string" default_value="7" />
  <UserPref name="bgColor" display_name="Background Color (rgba)" type="string" default_value="rgba(0,0,0,0.5)" />
  <UserPref name="textColor" display_name="Text Color" type="string" default_value="#ffffff" />
  <UserPref name="fontSize" display_name="Base Font Size (px)" type="string" default_value="16" />

  <Content type="html">
    <![CDATA[
      <!DOCTYPE html>
      <html>
      <head>
        <style>
          :root {
              --bg-color: rgba(0, 0, 0, 0.6);
              --text-color: #ffffff;
              --font-size: 16px;
          }
          body {
              margin: 0;
              padding: 12px;
              background-color: var(--bg-color);
              color: var(--text-color);
              font-family: Arial, sans-serif;
              font-size: var(--font-size);
              box-sizing: border-box;
              height: 100vh;
              overflow: hidden;
          }
          #calendar-container {
              display: flex;
              flex-direction: column;
              height: 100%;
          }
          #calendar-header {
              font-weight: bold;
              font-size: 1.1em;
              margin-bottom: 8px;
              border-bottom: 1px solid rgba(255, 255, 255, 0.3);
              padding-bottom: 4px;
          }
          #calendar-events {
              flex-grow: 1;
              overflow-y: auto;
          }
          .event-item {
              display: flex;
              flex-direction: column;
              margin-bottom: 10px;
              padding: 8px;
              background: rgba(255, 255, 255, 0.1);
              border-radius: 4px;
          }
          /* Weekly View Order: Date -> Time -> Meeting Name */
          .weekly-view .event-date { font-size: 0.85em; opacity: 0.8; order: 1; }
          .weekly-view .event-time { font-size: 0.9em; font-weight: bold; order: 2; color: #4facfe; }
          .weekly-view .event-name { font-size: 1em; order: 3; }

          /* Daily Prominent View Styles & Ordering */
          .daily-view {
              background: linear-gradient(135deg, rgba(79, 172, 254, 0.3), rgba(0, 242, 254, 0.3));
              border: 2px solid #00f2fe;
              padding: 16px;
              border-radius: 8px;
              text-align: center;
              justify-content: center;
              height: 100%;
              box-sizing: border-box;
          }
          .daily-view .event-name { font-size: 1.6em; font-weight: bold; order: 1; margin-bottom: 6px; }
          .daily-view .event-time { font-size: 1.3em; order: 2; margin-bottom: 4px; color: #ffeb3b; }
          .daily-view .event-date { font-size: 1.1em; order: 3; opacity: 0.9; }
        </style>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/ical.js/1.5.0/ical.min.js"></script>
      </head>
      <body>
        <div id="calendar-container">
          <div id="calendar-header"></div>
          <div id="calendar-events">Loading calendar...</div>
        </div>
        <script>
          var prefs = new gadgets.Prefs();

          function loadCalendar() {
              const icsUrl = prefs.getString('icsUrl');
              const mode = prefs.getString('mode') || 'weekly';
              const maxDays = parseInt(prefs.getString('maxDays') || '7');

              document.documentElement.style.setProperty('--bg-color', prefs.getString('bgColor') || 'rgba(0,0,0,0.5)');
              document.documentElement.style.setProperty('--text-color', prefs.getString('textColor') || '#ffffff');
              document.documentElement.style.setProperty('--font-size', (prefs.getString('fontSize') || '16') + 'px');

              if (!icsUrl) {
                  document.getElementById('calendar-events').innerHTML = '<div class="event-item">Please enter your Outlook ICS URL in the gadget properties.</div>';
                  return;
              }

              const proxyUrl = 'https://api.allorigins.win/raw?url=' + encodeURIComponent(icsUrl);
              
              fetch(proxyUrl)
                  .then(response => response.text())
                  .then(data => {
                      const jcalData = ICAL.parse(data);
                      const comp = new ICAL.Component(jcalData);
                      const vevents = comp.getAllSubcomponents('vevent');

                      const now = new Date();
                      const events = [];

                      vevents.forEach(vevent => {
                          const event = new ICAL.Event(vevent);
                          const startDate = event.startDate.toJSDate();

                          if (startDate >= now) {
                              events.push({
                                  title: event.summary,
                                  startDate: startDate,
                                  timeString: startDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                                  dateString: startDate.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' })
                              });
                          }
                      });

                      events.sort((a, b) => a.startDate - b.startDate);
                      render(events, mode, maxDays);
                  })
                  .catch(err => {
                      console.error(err);
                      document.getElementById('calendar-events').innerHTML = '<div class="event-item">Error loading calendar feed. Check URL or network.</div>';
                  });
          }

          function render(events, mode, maxDays) {
              const container = document.getElementById('calendar-events');
              const header = document.getElementById('calendar-header');
              container.innerHTML = '';

              if (events.length === 0) {
                  container.innerHTML = '<div class="event-item">No upcoming meetings.</div>';
                  return;
              }

              if (mode === 'daily') {
                  header.style.display = 'none';
                  const ev = events[0];
                  container.innerHTML = `
                      <div class="event-item daily-view">
                          <div class="event-name">${ev.title}</div>
                          <div class="event-time">${ev.timeString}</div>
                          <div class="event-date">${ev.dateString}</div>
                      </div>
                  `;
              } else {
                  header.style.display = 'block';
                  header.textContent = "Upcoming Schedule";
                  const filtered = events.filter(ev => (ev.startDate - new Date()) / (1000 * 60 * 60 * 24) <= maxDays);
                  
                  filtered.forEach(ev => {
                      const div = document.createElement('div');
                      div.className = 'event-item weekly-view';
                      div.innerHTML = `
                          <div class="event-date">${ev.dateString}</div>
                          <div class="event-time">${ev.timeString}</div>
                          <div class="event-name">${ev.title}</div>
                      `;
                      container.appendChild(div);
                  });
              }
          }

          gadgets.util.registerOnLoadHandler(loadCalendar);
          setInterval(loadCalendar, 15 * 60 * 1000);
        </script>
      </body>
      </html>
    ]]>
  </Content>
</Module>
