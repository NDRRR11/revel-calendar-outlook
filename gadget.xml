<?xml version="1.0" encoding="UTF-8" ?>
<Module>
  <ModulePrefs title="Custom Outlook ICS Calendar" description="Custom calendar gadget supporting weekly and daily views.">
    <Require feature="dynamic-height"/>
  </ModulePrefs>
  <UserPref name="icsUrl" display_name="Outlook ICS Webcal URL" default_value="" />
  <UserPref name="mode" display_name="View Mode (weekly or daily)" default_value="weekly" />
  <UserPref name="maxDays" display_name="Days to Show (Weekly)" default_value="7" />
  <UserPref name="bgColor" display_name="Background Color (e.g. rgba(0,0,0,0.5))" default_value="rgba(0, 0, 0, 0.5)" />
  <UserPref name="textColor" display_name="Text Color" default_value="#ffffff" />
  <UserPref name="fontSize" display_name="Base Font Size (px)" default_value="16" />
  <Content type="html">
    <![CDATA[
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="utf-8">
        <link rel="stylesheet" href="style.css">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/ical.js/1.5.0/ical.min.js"></script>
      </head>
      <body>
        <div id="calendar-container">
          <div id="calendar-header">Loading...</div>
          <div id="calendar-events"></div>
        </div>
        <script src="app.js"></script>
      </body>
      </html>
    ]]>
  </Content>
</Module>
